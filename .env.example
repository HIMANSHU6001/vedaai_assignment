# ==========================================
# Server Configuration
# ==========================================
# The port the Express API server will listen on. Default: 4000
PORT=4000

# The environment mode (development or production). Default: development
NODE_ENV=development

# Allowed CORS origin, pointing to the Next.js frontend client
CORS_ORIGIN=http://localhost:3000

# ==========================================
# Database & Cache Connections
# ==========================================
# MongoDB connection URI (e.g., MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vedaai?retryWrites=true&w=majority

# Redis Connection URL
# - Use "redis://redis:6379" when running within the Docker Compose network
# - Use "redis://127.0.0.1:6379" when running locally outside of Docker
REDIS_URL=redis://127.0.0.1:6379

# ==========================================
# Cloudinary Configuration (PDF Storage)
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==========================================
# LLM API Configuration (DigitalOcean GenAI)
# ==========================================
# DigitalOcean GenAI/DeepSeek API Key
DEEPSEEK_API_KEY=your_digitalocean_genai_api_key

# Base URL for the DigitalOcean Agent/Inference endpoint
DO_BASE_URL=https://inference.do-ai.run/v1/

# The DeepSeek model to be used (e.g., deepseek-chat or deepseek-v4-pro)
DEEPSEEK_MODEL=deepseek-v4-pro