# .env.example

# =========================
# Server Configuration
# =========================
# The port the HTTP API Gateway will listen on (Default: 4000)
PORT=4000

# The environment mode (development or production)
NODE_ENV=development

# Allowed origin for CORS (e.g., your Next.js frontend URL)
CORS_ORIGIN=http://localhost:3000

# =========================
# Database Connections
# =========================
# MongoDB Atlas connection string (Include the database name)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vedaai?retryWrites=true&w=majority

# Redis connection string (Upstash recommended for easy setup)
REDIS_URL=rediss://default:<password>@<upstash-endpoint>.upstash.io:<port>

# =========================
# Cloudinary Configuration
# =========================
# Cloudinary credentials for handling PDF and text file uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# =========================
# LLM API Configuration
# =========================
# DeepSeek V3 API credentials (via DigitalOcean managed inference)
DEEPSEEK_API_KEY=your_digitalocean_genai_api_key

# The base URL for the DigitalOcean hosted inference endpoint
# Example: https://<agent>.agents.hosted-inference.digitaloceanspaces.com/v1
DEEPSEEK_BASE_URL=your_digitalocean_base_url

# The model identifier to use
DEEPSEEK_MODEL=deepseek-chat